FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY scripts/run-directory.ts ./scripts/run-directory.ts
RUN npm ci && npm run build --workspace=@cgp/core \
    && mkdir -p /data && chown node:node /data
ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "node_modules/tsx/dist/cli.mjs", "scripts/run-directory.ts", "/config/directory.json"]
